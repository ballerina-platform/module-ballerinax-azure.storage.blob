{
  "version": "v1.0",
  "listeners": [
    {
      "id": "$listener",
      "doc": "Polls the queue each attached service names and dispatches the blob events it carries to that service.",
      "type": {
        "name": "Listener"
      },
      "services": [
        "$service"
      ],
      "multipleServicesAllowed": true,
      "multipleServicesOfSameTypeAllowed": true
    }
  ],
  "serviceTypes": [
    {
      "id": "$service",
      "doc": "Consumes the blob events of its queue, dispatching each created blob to the handler matching its name or content type.",
      "type": {
        "name": "Service"
      },
      "concrete": false,
      "multipleListenersAllowed": false,
      "annotations": [
        "$serviceConfig"
      ],
      "handlers": {
        "backedByConcreteType": false,
        "options": [
          {
            "id": "$service.onBlob",
            "name": "onBlob",
            "kind": "remote",
            "doc": "Invoked for any created blob no typed handler matched, and as the fallback when no typed handler is declared. Content arrives as raw bytes.",
            "presence": "optional",
            "annotations": [
              "$functionConfig"
            ],
            "params": [
              {
                "id": "$service.onBlob.content",
                "name": "content",
                "doc": "The blob's bytes. Declare the stream form to read a large blob in chunks rather than loading it into memory.",
                "type": [
                  {
                    "shape": "array",
                    "elementType": {
                      "name": "byte",
                      "builtin": true
                    }
                  },
                  {
                    "shape": "stream",
                    "elementType": {
                      "shape": "array",
                      "elementType": {
                        "name": "byte",
                        "builtin": true
                      }
                    },
                    "completionType": [
                      {
                        "name": "error",
                        "builtin": true
                      },
                      {
                        "name": "()",
                        "builtin": true
                      }
                    ]
                  }
                ],
                "presence": "required"
              },
              {
                "id": "$service.onBlob.event",
                "name": "event",
                "doc": "The blob event: its account, container, path, and URL, the kind of change, and its time.",
                "type": {
                  "name": "BlobEvent"
                },
                "presence": "optional"
              },
              {
                "id": "$service.onBlob.caller",
                "name": "caller",
                "doc": "The container connection, for reading or writing blobs while this event is handled.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onBlob.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          },
          {
            "id": "$service.onBlobText",
            "name": "onBlobText",
            "kind": "remote",
            "doc": "Invoked for each created .txt blob, or any created blob matching the patterns set on @blob:FunctionConfig. Falls through to onBlob when not declared.",
            "presence": "optional",
            "annotations": [
              "$functionConfig"
            ],
            "params": [
              {
                "id": "$service.onBlobText.content",
                "name": "content",
                "doc": "The blob's text content, decoded as UTF-8.",
                "type": {
                  "name": "string",
                  "builtin": true
                },
                "presence": "required"
              },
              {
                "id": "$service.onBlobText.event",
                "name": "event",
                "doc": "The blob event: its account, container, path, and URL, the kind of change, and its time.",
                "type": {
                  "name": "BlobEvent"
                },
                "presence": "optional"
              },
              {
                "id": "$service.onBlobText.caller",
                "name": "caller",
                "doc": "The container connection, for reading or writing blobs while this event is handled.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onBlobText.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          },
          {
            "id": "$service.onBlobJson",
            "name": "onBlobJson",
            "kind": "remote",
            "doc": "Invoked for each created .json blob, or any created blob matching the patterns set on @blob:FunctionConfig. Falls through to onBlob when not declared.",
            "presence": "optional",
            "annotations": [
              "$functionConfig"
            ],
            "params": [
              {
                "id": "$service.onBlobJson.content",
                "name": "content",
                "doc": "The parsed content; bind a record type to project it.",
                "type": {
                  "name": "json",
                  "builtin": true
                },
                "presence": "required",
                "dataBinding": {
                  "typedescs": [
                    {
                      "constraint": {
                        "name": "json",
                        "builtin": true
                      },
                      "shapes": [
                        {
                          "form": "bare"
                        }
                      ]
                    },
                    {
                      "constraint": {
                        "name": "record {}",
                        "builtin": true
                      },
                      "shapes": [
                        {
                          "form": "bare"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "id": "$service.onBlobJson.event",
                "name": "event",
                "doc": "The blob event: its account, container, path, and URL, the kind of change, and its time.",
                "type": {
                  "name": "BlobEvent"
                },
                "presence": "optional"
              },
              {
                "id": "$service.onBlobJson.caller",
                "name": "caller",
                "doc": "The container connection, for reading or writing blobs while this event is handled.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onBlobJson.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          },
          {
            "id": "$service.onBlobXml",
            "name": "onBlobXml",
            "kind": "remote",
            "doc": "Invoked for each created .xml blob, or any created blob matching the patterns set on @blob:FunctionConfig. Falls through to onBlob when not declared.",
            "presence": "optional",
            "annotations": [
              "$functionConfig"
            ],
            "params": [
              {
                "id": "$service.onBlobXml.content",
                "name": "content",
                "doc": "The parsed document; bind a record type to project it from its elements.",
                "type": {
                  "name": "xml",
                  "builtin": true
                },
                "presence": "required",
                "dataBinding": {
                  "typedescs": [
                    {
                      "constraint": {
                        "name": "xml",
                        "builtin": true
                      },
                      "shapes": [
                        {
                          "form": "bare"
                        }
                      ]
                    },
                    {
                      "constraint": {
                        "name": "record {}",
                        "builtin": true
                      },
                      "shapes": [
                        {
                          "form": "bare"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "id": "$service.onBlobXml.event",
                "name": "event",
                "doc": "The blob event: its account, container, path, and URL, the kind of change, and its time.",
                "type": {
                  "name": "BlobEvent"
                },
                "presence": "optional"
              },
              {
                "id": "$service.onBlobXml.caller",
                "name": "caller",
                "doc": "The container connection, for reading or writing blobs while this event is handled.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onBlobXml.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          },
          {
            "id": "$service.onBlobCsv",
            "name": "onBlobCsv",
            "kind": "remote",
            "doc": "Invoked for each created .csv blob, or any created blob matching the patterns set on @blob:FunctionConfig. Declaring a stream parameter reads the blob in chunks instead of loading it into memory. Falls through to onBlob when not declared.",
            "presence": "optional",
            "annotations": [
              "$functionConfig"
            ],
            "params": [
              {
                "id": "$service.onBlobCsv.content",
                "name": "content",
                "doc": "The parsed rows, as batched or streamed string rows or records; a record row's field names come from the header row.",
                "type": [
                  {
                    "shape": "array",
                    "elementType": {
                      "shape": "array",
                      "elementType": {
                        "name": "string",
                        "builtin": true
                      }
                    }
                  },
                  {
                    "shape": "array",
                    "elementType": {
                      "name": "record {}",
                      "builtin": true
                    }
                  },
                  {
                    "shape": "stream",
                    "elementType": {
                      "shape": "array",
                      "elementType": {
                        "name": "string",
                        "builtin": true
                      }
                    },
                    "completionType": [
                      {
                        "name": "error",
                        "builtin": true
                      },
                      {
                        "name": "()",
                        "builtin": true
                      }
                    ]
                  },
                  {
                    "shape": "stream",
                    "elementType": {
                      "name": "record {}",
                      "builtin": true
                    },
                    "completionType": [
                      {
                        "name": "error",
                        "builtin": true
                      },
                      {
                        "name": "()",
                        "builtin": true
                      }
                    ]
                  }
                ],
                "presence": "required",
                "dataBinding": {
                  "typedescs": [
                    {
                      "constraint": {
                        "shape": "array",
                        "elementType": {
                          "name": "string",
                          "builtin": true
                        }
                      },
                      "shapes": [
                        {
                          "form": "array",
                          "element": "bare"
                        },
                        {
                          "form": "stream",
                          "element": "bare",
                          "completionType": [
                            {
                              "name": "error",
                              "builtin": true
                            },
                            {
                              "name": "()",
                              "builtin": true
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "constraint": {
                        "name": "record {}",
                        "builtin": true
                      },
                      "shapes": [
                        {
                          "form": "array",
                          "element": "bare"
                        },
                        {
                          "form": "stream",
                          "element": "bare",
                          "completionType": [
                            {
                              "name": "error",
                              "builtin": true
                            },
                            {
                              "name": "()",
                              "builtin": true
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "id": "$service.onBlobCsv.event",
                "name": "event",
                "doc": "The blob event: its account, container, path, and URL, the kind of change, and its time.",
                "type": {
                  "name": "BlobEvent"
                },
                "presence": "optional"
              },
              {
                "id": "$service.onBlobCsv.caller",
                "name": "caller",
                "doc": "The container connection, for reading or writing blobs while this event is handled.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onBlobCsv.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          },
          {
            "id": "$service.onBlobDelete",
            "name": "onBlobDelete",
            "kind": "remote",
            "doc": "Invoked for each deleted blob. There is no content, because the blob is already gone.",
            "presence": "optional",
            "params": [
              {
                "id": "$service.onBlobDelete.event",
                "name": "event",
                "doc": "The blob event: its account, container, path, and URL, the kind of change, and its time.",
                "type": {
                  "name": "BlobEvent"
                },
                "presence": "required"
              },
              {
                "id": "$service.onBlobDelete.caller",
                "name": "caller",
                "doc": "The container connection, for reading or writing blobs while this event is handled.",
                "type": {
                  "name": "Caller"
                },
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onBlobDelete.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          },
          {
            "id": "$service.onError",
            "name": "onError",
            "kind": "remote",
            "doc": "Invoked when a poll, a message parse, a content fetch or binding, or a poison move fails.",
            "presence": "optional",
            "params": [
              {
                "id": "$service.onError.err",
                "name": "err",
                "doc": "The failure the listener reports.",
                "type": {
                  "name": "Error"
                },
                "presence": "required"
              },
              {
                "id": "$service.onError.event",
                "name": "event",
                "doc": "The event the failure belongs to, or () when there is none.",
                "type": [
                  {
                    "name": "BlobEvent"
                  },
                  {
                    "name": "()",
                    "builtin": true
                  }
                ],
                "presence": "optional"
              },
              {
                "id": "$service.onError.caller",
                "name": "caller",
                "doc": "The container connection, or () when the failure carries no event.",
                "type": [
                  {
                    "name": "Caller"
                  },
                  {
                    "name": "()",
                    "builtin": true
                  }
                ],
                "presence": "optional"
              }
            ],
            "returns": {
              "id": "$service.onError.returns",
              "type": [
                {
                  "name": "error",
                  "builtin": true
                },
                {
                  "name": "()",
                  "builtin": true
                }
              ]
            }
          }
        ]
      },
      "rules": [
        {
          "id": "$atLeastOneHandler",
          "rule": "structure.atLeastOne",
          "message": "An Azure Blob Storage service must declare at least one of onBlob, onBlobText, onBlobJson, onBlobXml, onBlobCsv, or onBlobDelete. onError alone never receives an event, so the service would do nothing.",
          "subjects": [
            {
              "kind": "handler",
              "id": "$service.onBlob"
            },
            {
              "kind": "handler",
              "id": "$service.onBlobText"
            },
            {
              "kind": "handler",
              "id": "$service.onBlobJson"
            },
            {
              "kind": "handler",
              "id": "$service.onBlobXml"
            },
            {
              "kind": "handler",
              "id": "$service.onBlobCsv"
            },
            {
              "kind": "handler",
              "id": "$service.onBlobDelete"
            }
          ]
        }
      ]
    }
  ],
  "annotations": [
    {
      "id": "$serviceConfig",
      "type": {
        "name": "ServiceConfig"
      },
      "attachPoint": "service",
      "presence": "required"
    },
    {
      "id": "$functionConfig",
      "type": {
        "name": "FunctionConfig"
      },
      "attachPoint": "function",
      "presence": "optional"
    }
  ]
}
